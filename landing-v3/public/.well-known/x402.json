{
  "version": "0.1.0",
  "protocol": "x402",
  "name": "Clicks Protocol",
  "description": "Post-payment settlement routing for x402-style USDC revenue flows",
  "provider": {
    "name": "Clicks Protocol",
    "url": "https://clicksprotocol.xyz",
    "contact": "hello@clicksprotocol.xyz"
  },
  "status": {
    "role": "post_payment_settlement",
    "automatic_x402_interception": false,
    "built_in_x402_payment_verification": false,
    "x402_revenue_adapter": "planned"
  },
  "capabilities": {
    "split": {
      "liquid": 0.8,
      "earning": 0.2
    },
    "settlement": {
      "chain": "base",
      "currency": "USDC",
      "contract": "0xB7E0016d543bD443ED2A6f23d5008400255bf3C8"
    },
    "yield": {
      "enabled": true,
      "providers": ["aave-v3", "morpho"],
      "rate": "variable"
    }
  },
  "integration": {
    "sdk": {
      "npm": "@clicks-protocol/sdk",
      "repo": "https://github.com/clicks-protocol/clicks-protocol"
    },
    "mcp": {
      "npm": "@clicks-protocol/mcp-server",
      "repo": "https://github.com/clicks-protocol/clicks-protocol"
    }
  },
  "links": {
    "documentation": "https://clicksprotocol.xyz/docs",
    "github": "https://github.com/clicks-protocol",
    "discord": "https://discord.gg/FfmJGUcxfe",
    "twitter": "https://x.com/ClicksProtocol"
  }
}
